function inspectStep(s) {
  currentStep = s;
  const item = shirts[currentIndex], shirtData = SHIRTS[currentIndex], info = STEPS[s];

  document.querySelectorAll('.step-btn').forEach((b, i) => b.classList.toggle('active', i === s));

  const panelElements = [
    document.getElementById('detail-tag'),
    document.getElementById('detail-title'),
    document.getElementById('detail-desc'),
    document.getElementById('motivational-quote')
  ];
  gsap.fromTo(panelElements, { opacity: 0.25, x: -8 }, { opacity: 1, x: 0, duration: 0.35, stagger: 0.04, overwrite: "auto" });

  document.getElementById('detail-tag').textContent = info.tag;
  document.getElementById('detail-title').textContent = s === 0 ? shirtData.name : info.title;
  document.getElementById('detail-desc').textContent = info.desc;
  document.getElementById('motivational-quote').textContent = info.quote;

  const floatOverlay = document.getElementById('floating-360-overlay');
  if (info.showFloating && currentMode === 'detail') {
    document.getElementById('float-badge').textContent = info.floatBadge;
    document.getElementById('float-title').textContent = info.floatTitle;
    document.getElementById('float-text').textContent = info.floatText;
    floatOverlay.classList.add('visible');
  } else {
    floatOverlay.classList.remove('visible');
  }

  gsap.to(item.rotation, { y: info.ry, z: info.rz, duration: 0.85, ease: "expo.out", overwrite: "auto" });
  gsap.to(item.position, { y: info.y, duration: 0.85, ease: "expo.out", overwrite: "auto" });
  gsap.to(camera.position, { z: info.camZ, duration: 0.85, ease: "expo.out", overwrite: "auto" });
}

function selectSize(btn) {
  document.querySelectorAll('.size-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

function selectGender(gender, btn) {
  currentGender = gender;
  document.querySelectorAll('.gender-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  applyGenderFit(0.5);
}

const clock = new THREE.Clock();
function animate() {
  requestAnimationFrame(animate);
  const t = clock.getElapsedTime();
  shirts.forEach((item, i) => {
    item.position.y += Math.sin(t * 2.0 + i) * 0.001;
  });
  camera.lookAt(cameraTarget);
  renderer.render(scene, camera);
}

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

updatePositions(0);
animate();
